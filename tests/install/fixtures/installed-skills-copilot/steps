# The same for Copilot: .agents/skills/ reaches .github/skills/, .claude/skills/
# does not, and a command packaged as a skill of the same name wins.
mkdir -p "$ENGINE/.agents/skills/probe" "$ENGINE/.claude/skills/claude-only" "$ENGINE/.agents/skills/sdd-status"
printf -- '---\nname: probe\ndescription: A probe.\n---\n' > "$ENGINE/.agents/skills/probe/SKILL.md"
printf -- '---\nname: claude-only\ndescription: Claude.\n---\n' > "$ENGINE/.claude/skills/claude-only/SKILL.md"
printf -- '---\nname: sdd-status\ndescription: A clash.\n---\n' > "$ENGINE/.agents/skills/sdd-status/SKILL.md"
sdd --target "$TARGET" --for copilot

expect "the installed skill lands where Copilot reads skills" test -f .github/skills/probe/SKILL.md
expect "a skill for the other host does not arrive" test ! -e .github/skills/claude-only
expect "a command of the same name stays the engine's" cmp -s .github/skills/sdd-status/SKILL.md "$ENGINE/.sdd/commands/sdd-status.md"
said "the clash is named" "skipped — the engine ships a skill of that name"

sdd --uninstall "$TARGET"

expect "uninstall removes it with the rest" test ! -e .github/skills/probe/SKILL.md
