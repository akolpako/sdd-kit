# The same uninstall on the other host, where the file sits inside a skill
# directory .github/ shares with the project.
sdd --target "$TARGET" --for copilot
printf 'This command was rewritten by the project.\n' > "$TARGET/.github/skills/sdd-status/SKILL.md"
sdd --uninstall "$TARGET"

expect "the edited file is still there" grep -q 'rewritten by the project' .github/skills/sdd-status/SKILL.md
expect "an untouched one is gone" test ! -e .github/skills/sdd-init/SKILL.md
expect "and the manifest stays, because it still describes a file on disk" test -f .sdd/.sdd-manifest
